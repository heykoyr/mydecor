# ─── AI providers ────────────────────────────────────────────────────────────
# All keys are read server-side only. Never prefix them with NEXT_PUBLIC_.

# Room understanding (vision). Leave unset to run the built-in heuristic analyser.
VISION_PROVIDER=auto                # auto | anthropic | heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# In-room visualisation. Leave unset to run the built-in canvas compositor.
VISUALIZATION_PROVIDER=auto         # auto | inpaint | composite
INPAINT_API_URL=
INPAINT_API_KEY=

# ─── Commerce ────────────────────────────────────────────────────────────────
# Product catalogue source. Leave unset to use the bundled reference catalogue.
CATALOG_PROVIDER=static             # static | http
CATALOG_API_URL=
CATALOG_API_KEY=
AFFILIATE_TAG=
