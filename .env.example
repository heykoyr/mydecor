# Copy to .env.local. Every key here is read server-side only — never prefix one
# with NEXT_PUBLIC_. The app runs with none of them set; each one turns a
# capability on.

# ─── Room understanding ──────────────────────────────────────────────────────
# Without a key the app analyses the photo on-device and finds surfaces only —
# walls, windows, floors, corners — and says so in the UI. With one, it also
# recognises furniture, which unlocks the sofa, bed, table, desk and TV ideas.
VISION_PROVIDER=auto                # auto | anthropic | heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# ─── Retailers ───────────────────────────────────────────────────────────────
# With none of these set, the app uses its bundled reference catalogue and
# states on every product that the items are not purchasable.

# Etsy Open API v3. A read-only key is issued immediately at
# https://www.etsy.com/developers — this is the quickest source to turn on.
ETSY_API_KEY=

# Everything else — Amazon, Temu, Jumia, Konga — reaches third-party apps as an
# affiliate product feed rather than a public search API. Point this at any JSON
# feed and map its fields; no new code is needed per retailer.
#
# PRODUCT_FEEDS='[{
#   "id": "jumia",
#   "name": "Jumia Nigeria",
#   "shortName": "Jumia",
#   "url": "https://your-feed-host/products?q={query}&limit={limit}",
#   "shipsTo": ["NG"],
#   "currency": "NGN",
#   "headers": { "Authorization": "Bearer ..." },
#   "itemsPath": "data.products",
#   "map": {
#     "externalId": "sku",
#     "title": "name",
#     "price": "price.value",
#     "currency": "price.currency",
#     "image": "images.0.url",
#     "link": "product_url"
#   }
# }]'
PRODUCT_FEEDS=

# Retailer image hosts the proxy at /api/image is allowed to fetch. Etsy's CDN
# is allowed by default; add the hosts your feeds serve images from. The proxy
# refuses anything not listed, so it cannot be used as an open relay.
IMAGE_HOST_ALLOWLIST=

# Appended to outbound product links for affiliate attribution.
AFFILIATE_TAG=

# ─── Deployment ──────────────────────────────────────────────────────────────
# Canonical origin. On Vercel this is derived automatically; set it only to
# override, e.g. for a custom domain.
NEXT_PUBLIC_APP_URL=
